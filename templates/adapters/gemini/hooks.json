{
  "ba": {
    "SessionStart": [
      {
        "type": "command",
        "command": "bash ./scripts/session-start.sh"
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "bash ./scripts/auto-guard.sh"
      }
    ],
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "bash ./scripts/secret-guard.sh",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
